<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />
    <title>
        @(ViewData["Title"] != null
            ? $"{ViewData["Title"]} |  Dashboard"
            : "Dashboard")
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <!-- Razor CSS Isolation -->
    <link rel="stylesheet" href="~/Dashboard.WebApp.styles.css" asp-append-version="true" />

</head>

<body>

    <div class="wrapper">

        <!-- Sidebar -->

        <aside class="sidebar">
            <div class="logo">
                <h3>Dashboard</h3>
            </div>
            <ul>
                <li>
                    <a asp-page="/Index">
                        <i class="bi bi-house"></i>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a asp-page="/Users">
                        <i class="bi bi-people"></i>
                        Users
                    </a>
                </li>
                <li>
                    <a asp-page="/Organizations">
                        <i class="bi bi-building"></i>
                        Organizations
                    </a>
                </li>
                <li>
                    <a asp-page="/Roles">
                        <i class="bi bi-diagram-3"></i>
                        Roles
                    </a>
                </li>
                <li>
                    <a asp-page="/Settings">
                        <i class="bi bi-gear"></i>
                        Settings
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main -->
        <div class="main-content">
            <!-- Top Navbar -->
            <nav class="topbar">
                <div>
                    <input class="search"
                           placeholder="Search..." />
                </div>
                <div class="profile">
                    <span>Administrator</span>
                    <img src="https://i.pravatar.cc/100"
                         alt="Profile" />
                </div>
            </nav>
            <main class="content">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", false)

</body>

</html>