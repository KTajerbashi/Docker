@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["FullBleed"] = true;
}

<section class="dashboard-hero">
    <div class="container">
        <h1 class="fw-semibold mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Overview of provider and client activity</p>
    </div>
</section>

<div class="container dashboard-body">

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-label">Active Providers</span>
                <span class="stat-value">@Model.Dashboard.ProviderSummary.TotalActive</span>
                <span class="stat-trend @(Model.Dashboard.ProviderSummary.GrowthPercent >= 0 ? "up" : "down")">
                    @Model.Dashboard.ProviderSummary.GrowthPercent.ToString("+0.0;-0.0")%
                </span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-label">Pending Onboarding</span>
                <span class="stat-value">@Model.Dashboard.ProviderSummary.PendingOnboarding</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <span class="stat-label">Active Clients</span>
                <span class="stat-value">@Model.Dashboard.ClientSummary.TotalActive</span>
                <span class="stat-trend @(Model.Dashboard.ClientSummary.GrowthPercent >= 0 ? "up" : "down")">
                    @Model.Dashboard.ClientSummary.GrowthPercent.ToString("+0.0;-0.0")%
                </span>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel">
                <div class="panel-header d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0">Recent Activity</h2>
                </div>
                <div class="panel-body p-0">
                    @if (Model.Dashboard.RecentActivity.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">No recent activity.</p>
                    }
                    else
                    {
                        <ul class="activity-list list-unstyled mb-0">
                            @foreach (var item in Model.Dashboard.RecentActivity)
                            {
                                <li class="activity-item">
                                    <span class="activity-dot activity-dot--@item.Kind.ToString().ToLowerInvariant()"></span>
                                    <div>
                                        <div class="fw-semibold">@item.Title</div>
                                        <div class="text-muted small">@item.Description</div>
                                    </div>
                                    <time class="text-muted small ms-auto" datetime="@item.Timestamp.ToString("o")">
                                        @item.Timestamp.ToLocalTime().ToString("MMM d, HH:mm")
                                    </time>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel">
                <div class="panel-header">
                    <h2 class="h6 mb-0">Quick Actions</h2>
                </div>
                <div class="panel-body d-grid gap-2">
                    <a asp-page="/Providers" class="btn btn-outline-primary btn-sm text-start">Manage Providers</a>
                    <a asp-page="/Clients" class="btn btn-outline-primary btn-sm text-start">Manage Clients</a>
                    <a asp-page="/Profile" class="btn btn-outline-secondary btn-sm text-start">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>