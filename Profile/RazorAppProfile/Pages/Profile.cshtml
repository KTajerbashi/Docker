@page
@model RazorAppProfile.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<div class="app-container">
    <div class="app-content">

        <div class="profile-header">
            <div class="profile-avatar">
                <img src="~/images/avatar-placeholder.png" alt="User avatar" />
            </div>
            <div class="profile-heading">
                <h1 class="profile-name">Jane Doe</h1>
                <p class="profile-role">Senior Account Manager</p>
                <span class="profile-status profile-status--active">Active</span>
            </div>
            <div class="profile-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm">Edit Profile</button>
                <button type="button" class="btn btn-primary btn-sm">Change Password</button>
            </div>
        </div>

        <div class="profile-grid">

            <section class="panel">
                <div class="panel-header">
                    <h2 class="h6 mb-0">Contact Information</h2>
                </div>
                <div class="panel-body">
                    <dl class="info-list">
                        <div class="info-row">
                            <dt>Email</dt>
                            <dd>jane.doe@example.com</dd>
                        </div>
                        <div class="info-row">
                            <dt>Phone</dt>
                            <dd>+1 (555) 012-3456</dd>
                        </div>
                        <div class="info-row">
                            <dt>Location</dt>
                            <dd>Chicago, IL</dd>
                        </div>
                        <div class="info-row">
                            <dt>Department</dt>
                            <dd>Client Services</dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel">
                <div class="panel-header">
                    <h2 class="h6 mb-0">Account Details</h2>
                </div>
                <div class="panel-body">
                    <dl class="info-list">
                        <div class="info-row">
                            <dt>Username</dt>
                            <dd>jane.doe</dd>
                        </div>
                        <div class="info-row">
                            <dt>Member Since</dt>
                            <dd>March 12, 2022</dd>
                        </div>
                        <div class="info-row">
                            <dt>Last Login</dt>
                            <dd>Today, 09:24 AM</dd>
                        </div>
                        <div class="info-row">
                            <dt>Two-Factor Auth</dt>
                            <dd><span class="badge-2fa badge-2fa--on">Enabled</span></dd>
                        </div>
                    </dl>
                </div>
            </section>

            <section class="panel profile-grid-full">
                <div class="panel-header">
                    <h2 class="h6 mb-0">Preferences</h2>
                </div>
                <div class="panel-body">
                    <div class="pref-row">
                        <span>Email Notifications</span>
                        <span class="pref-toggle pref-toggle--on">On</span>
                    </div>
                    <div class="pref-row">
                        <span>SMS Alerts</span>
                        <span class="pref-toggle pref-toggle--off">Off</span>
                    </div>
                    <div class="pref-row">
                        <span>Weekly Summary Report</span>
                        <span class="pref-toggle pref-toggle--on">On</span>
                    </div>
                </div>
            </section>

        </div>
    </div>
</div>