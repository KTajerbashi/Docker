@page
@model RazorAppProfile.Pages.ProvidersModel
@{
    ViewData["Title"] = "Providers";
}

<div class="app-container">
    <div class="app-content">

        <div class="page-heading">
            <div>
                <h1 class="h4 mb-0">Providers</h1>
                <p class="text-muted mb-0 small">@Model.Providers.Count total providers</p>
            </div>
        </div>

        <div class="panel">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 providers-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Specialty</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Active Clients</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var provider in Model.Providers)
                        {
                            <tr class="provider-row"
                                role="button"
                                tabindex="0"
                                data-bs-toggle="modal"
                                data-bs-target="#providerDetailModal"
                                data-id="@provider.Id"
                                data-name="@provider.Name"
                                data-specialty="@provider.Specialty"
                                data-location="@provider.Location"
                                data-status="@provider.Status"
                                data-contact="@provider.ContactName"
                                data-email="@provider.Email"
                                data-phone="@provider.Phone"
                                data-onboarded="@provider.OnboardedOn.ToString("MMM d, yyyy")"
                                data-clients="@provider.ActiveClientCount">
                                <td class="fw-semibold">@provider.Name</td>
                                <td>@provider.Specialty</td>
                                <td>@provider.Location</td>
                                <td>
                                    <span class="status-badge status-badge--@provider.Status.ToString().ToLowerInvariant()">
                                        @provider.Status
                                    </span>
                                </td>
                                <td class="text-end">@provider.ActiveClientCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Provider Detail Modal -->
<div class="modal fade" id="providerDetailModal" tabindex="-1" aria-labelledby="providerDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="providerDetailModalLabel">Provider Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="info-list">
                    <div class="info-row">
                        <dt>Name</dt>
                        <dd id="pd-name"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Specialty</dt>
                        <dd id="pd-specialty"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Location</dt>
                        <dd id="pd-location"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Status</dt>
                        <dd id="pd-status"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Contact</dt>
                        <dd id="pd-contact"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Email</dt>
                        <dd id="pd-email"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Phone</dt>
                        <dd id="pd-phone"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Onboarded</dt>
                        <dd id="pd-onboarded"></dd>
                    </div>
                    <div class="info-row">
                        <dt>Active Clients</dt>
                        <dd id="pd-clients"></dd>
                    </div>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const modalEl = document.getElementById('providerDetailModal');
            if (!modalEl) return;

            modalEl.addEventListener('show.bs.modal', function (event) {
                const row = event.relatedTarget;
                if (!row) return;

                const fields = ['name', 'specialty', 'location', 'status', 'contact', 'email', 'phone', 'onboarded', 'clients'];
                fields.forEach(function (field) {
                    const target = document.getElementById('pd-' + field);
                    if (target) {
                        target.textContent = row.dataset[field] ?? '—';
                    }
                });
            });

            // Keyboard accessibility: allow Enter/Space to trigger row click
            document.querySelectorAll('.provider-row').forEach(function (row) {
                row.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        row.click();
                    }
                });
            });
        })();
    </script>
}