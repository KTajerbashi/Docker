@{
    var isFullBleed = ViewData["FullBleed"] as bool? == true;

    string ActivePage(string page) =>
        ViewContext.RouteData.Values["page"]?.ToString()?.Equals(page, StringComparison.OrdinalIgnoreCase) == true
            ? "active"
            : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Modern ASP.NET Core Razor Pages Application" />
    <meta name="theme-color" content="#0b0f19" />

    <title>
        @(ViewData["Title"] != null
            ? $"{ViewData["Title"]} | RazorAppProfile"
            : "RazorAppProfile")
    </title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Razor CSS Isolation -->
    <link rel="stylesheet" href="~/RazorAppProfile.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isFullBleed ? "has-fullbleed-page" : "")">

    <header class="site-header shadow-sm">
        <nav class="navbar navbar-expand-md navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">RazorAppProfile</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link @ActivePage("/Index")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActivePage("/Privacy")" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActivePage("/Profile")" asp-area="" asp-page="/Profile">Profile</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActivePage("/Providers")" asp-area="" asp-page="/Providers">Providers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ActivePage("/Clients")" asp-area="" asp-page="/Clients">Clients</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main @(isFullBleed ? "" : "container")">
        @RenderBody()
    </main>

    <footer class="site-footer border-top">
        <div class="container d-flex flex-wrap justify-content-between py-3 small text-muted">
            <span>&copy; @DateTime.Now.Year - RazorAppProfile</span>
            <span>
                <a asp-area="" asp-page="/Privacy" class="text-muted text-decoration-none">Privacy</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>